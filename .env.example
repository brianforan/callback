# `make init` copies this to .env and fills in the two secrets and HTTP_BIND. Never commit .env.
POSTGRES_PASSWORD=
SECRET_KEY=

# Where the web UI is published on this machine. Loopback only by default.
HTTP_BIND=127.0.0.1:8080

# Job boards that need a key. A blank one shows as "Needs setup" on the Job listings page.
# https://jooble.org/api/about
JOOBLE_API_KEY=
# https://findwork.dev/developers/
FINDWORK_API_KEY=
# Optional. The Muse works without it at a lower rate limit, but asks you to register
# for use beyond testing. https://www.themuse.com/developers/api/v2
MUSE_API_KEY=

# Resume tailoring and Scout. Only the tailor container makes model calls with it. The
# billing container also reads it, for usage reports, when there's no Admin key. Leave it blank
# to turn tailoring off: jobs then fail with "Tailoring isn't set up".
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
# The ID (apikey_...) of the key in ANTHROPIC_API_KEY, and the workspace (wrkspc_...) it belongs
# to, so the reports count only what Callback spends. Blank counts the whole organization, which
# is right when nothing else uses the account.
BILLING_API_KEY_ID=
BILLING_WORKSPACE_ID=

# Everything else keeps its docker-compose.yml default. Add a line here only to change one:
# COOKIE_SECURE, REGISTRATION_ENABLED, DEFAULT_USER_ID, STALE_AFTER_DAYS, LISTINGS_CACHE_MINUTES,
# INDEED_ENABLED, LINKEDIN_ENABLED, ANTHROPIC_ADMIN_API_KEY or the *_MODEL settings. Daily limits
# on model calls are set in Admin -> Settings.
